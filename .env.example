# Copia este archivo a .env y completa con los valores reales
# (ver README o documentación de astro-decap-cms-oauth)

# GitHub OAuth App - Client ID (Settings > Developer settings > OAuth Apps)
OAUTH_GITHUB_CLIENT_ID=

# GitHub OAuth App - Client Secret
OAUTH_GITHUB_CLIENT_SECRET=

# Solo si usas GitHub App en vez de OAuth App
# OAUTH_GITHUB_REPO_ID=

# Opcional: cambiar la versión del bundle de Decap CMS
# (por defecto fijada en astro.config.mjs via decapCMSSrcUrl)
# PUBLIC_DECAP_CMS_SRC_URL=https://unpkg.com/decap-cms@3.11.0/dist/decap-cms.js
