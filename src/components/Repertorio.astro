---
import site from "../data/site.json";
---

<section id="repertorio" class="section section-muted">
  <div class="container">
    <h2>{site.repertorioTitle}</h2>
    <p>{site.repertorioIntro}</p>
    <ul class="repertoire-list">
      {site.repertorio.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>
