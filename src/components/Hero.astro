---
interface Props {
  site: {
    title: string;
    instrument: string;
    description: string;
  };
}

const { site } = Astro.props;
---

<section id="hero" class="section hero">
  <div class="container">
    <p class="eyebrow">{site.instrument}</p>
    <h1>{site.title}</h1>
    <p class="lead">{site.description}</p>
    <a class="button" href="#contacto">Reservar fecha</a>
  </div>
</section>
